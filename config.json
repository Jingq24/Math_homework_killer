  "matrix_style": {
    "use_word_table": true,
    "use_handwriting_fonts": true,
    "font_name": "Patrick Hand",
    "font_size": 15,
    "bracket_size_scale": 2.0
  },
  "export_formats": [
    "docx",
    "pdf",
    "html",
    "rtf"
  ],
  "homework_ai": {
    "enabled": true,
    "provider": "dashscope",
    "api_key_env": "DASHSCOPE_API_KEY",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen-vl-plus",
    "timeout_seconds": 120,
    "max_tokens": 4096,
    "temperature": 0.3,
    "export_formats": [
      "pdf"
    ],
    "merge_pdf": true,
    "merged_pdf_name": "homework_all.pdf",
    "save_intermediate_markdown": true
  },
  "handwriting_style": {
    "paragraph_left_indent_max": 16,
    "paragraph_first_line_indent_max": 10,
    "paragraph_space_before_max": 8,
    "line_spacing_range": [
      13,
      20
    ],
    "math_line_spacing_range": [
      16,
      22
    ],
    "position_jitter": 5.0,
    "spacing_jitter": 5.0,
    "size_jitter": 0.12,
    "word_font_switch_chance": 0.12,
    "math_font_switch_multiplier": 0.3,
    "math_size_jitter": 0.1,
    "math_position_jitter": 3.5,
    "math_spacing_jitter": 4.0,
    "math_scaling_range": [
      88,
      112
    ],
    "scaling_range": [
      90,
      112
    ],
    "heading_position_boost": 1.3
  }
